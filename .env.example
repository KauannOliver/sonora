# ---------------------------------------------------------------
# VozIA Studio — variáveis de ambiente (copie para .env.local)
# ---------------------------------------------------------------

# Chave ElevenLabs padrão do site (Texto → Voz)
ELEVENLABS_API_KEY=sk_sua_chave_aqui

# Chaves Groq padrão do site (Voz → Texto), separadas por vírgula.
# A segunda é usada como failover automático quando a primeira atinge o rate limit.
GROQ_API_KEYS=gsk_primaria,gsk_secundaria

# Cota gratuita diária por visitante ao usar as chaves padrão.
# Ao atingir o limite, o site pede que o usuário informe a própria chave.
FREE_TTS_CHARS_PER_DAY=1000
FREE_TRANSCRIPTIONS_PER_DAY=10
